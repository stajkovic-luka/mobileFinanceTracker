    {
      "name": "Reports",
      "item": [
        {
          "name": "Create report",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function formatDate(date) {",
                  "    const year = date.getFullYear();",
                  "    const month = String(date.getMonth() + 1).padStart(2, \"0\");",
                  "    const day = String(date.getDate()).padStart(2, \"0\");",
                  "",
                  "    return `${year}-${month}-${day}`;",
                  "}",
                  "",
                  "const to = new Date();",
                  "const from = new Date();",
                  "from.setDate(to.getDate() - 30);",
                  "",
                  "pm.environment.set(\"reportFrom\", formatDate(from));",
                  "pm.environment.set(\"reportTo\", formatDate(to));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/deposits?from={{reportFrom}}&to={{reportTo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "deposits"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{reportFrom}}",
                  "description": "datum od"
                },
                {
                  "key": "to",
                  "value": "{{reportTo}}",
                  "description": "datum do"
                }
              ]
            }
          },
          "response": []
        }
      ]
